---
// A compliance page (REWRITE.md § 2, § E8): the approved text of record from
// legal-reference/<page>.html, injected raw and unaltered, inside the same
// <section> wrapper the legacy page had. Never edit the text here; it changes
// only in legal-reference/, by an approved commit of its own.
import Paper from './Paper.astro';

interface Props {
  /** The section id the legacy page used: privacy, terms, sms, career-send. */
  id: string;
  /** The exact bytes of legal-reference/<id>.html (imported with ?raw). */
  record: string;
  title: string;
  description: string;
  robots?: string;
}
const { id, record, title, description, robots } = Astro.props;
---
<Paper title={title} description={description} robots={robots}>
  <section class="section legal-page" id={id}>
    <Fragment set:html={record} />
  </section>
</Paper>
