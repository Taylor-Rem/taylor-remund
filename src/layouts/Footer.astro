---
// The footer every page carries (REWRITE.md § 2: Privacy, Terms, SMS on every
// page; § F1: Services too). Nothing links to /career-send/, on purpose.
// The year is the build's. Styled by src/styles/paper.css on the paper pages;
// the stage styles its own.
import { site } from '../content/site.ts';
const year = new Date().getFullYear();
---
<footer class="footer">
  <p class="footer-owner">{site.footer.owner.text} &middot; {year}</p>
  <p class="footer-links">{site.footer.links.map((link, i) => (
    <span class="footer-link">{i > 0 && <span class="sep" aria-hidden="true">&middot;</span>}<a href={link.href}>{link.text}</a></span>
  ))}</p>
</footer>
