---
// Placeholder for P0. The paperwork's sections exist so the anchors of
// REWRITE.md § 2 keep working; their content arrives with § F1.
// Title and description are the live page's until Taylor words new ones (§ F1).
import Stage from '../layouts/Stage.astro';
import { site } from '../content/site.ts';

const sections = ['patchlamp', 'services', 'about', 'contact'] as const;
---
<Stage
  title="Taylor Remund — Patchlamp, software for small businesses"
  description="Patchlamp changes the website when you text it. Built and run in Utah by Taylor Remund, with hands-on AI services around it."
>
  <main id="paperwork">
    {sections.map((id) => (
      <section id={id}>
        <h2>{site.paperwork[id].text}</h2>
      </section>
    ))}
  </main>
</Stage>
