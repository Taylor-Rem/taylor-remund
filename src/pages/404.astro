---
// Placeholder 404 (REWRITE.md § F1): a heading and the four links.
import { site } from '../content/site.ts';
import Footer from '../layouts/Footer.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.notFound.title.text} | {site.strip.name.text}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main>
      <h1>{site.notFound.title.text}</h1>
      <ul>
        {site.strip.links.map((link) => <li><a href={link.href}>{link.text}</a></li>)}
      </ul>
    </main>
    <Footer />
  </body>
</html>
