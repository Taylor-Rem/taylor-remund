---
// The settings control in the strip (P3 B3; REWRITE.md § B7 "then Read, sound, and settings"): mounted in the
// layout's `strip-end` slot. A real button with its word; on a phone held upright the word gives way to a
// drawn glyph and stays its accessible name (Stage.astro's strip CSS). It opens the panel
// (SettingsPanel.astro, ui/settings/panel.ts); shell/home-early.ts wires it. Without JavaScript it is not shown.
import { site } from '../../../content/site.ts';
const w = site.settings;
---
<button class="settings-open" type="button" aria-expanded="false" aria-controls="settings" aria-haspopup="dialog"><svg class="glyph" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M8.6 1.5h2.8l.5 2.4 1.4.6 2-1.4 2 2-1.4 2 .6 1.4 2.4.5v2.8l-2.4.5-.6 1.4 1.4 2-2 2-2-1.4-1.4.6-.5 2.4H8.6l-.5-2.4-1.4-.6-2 1.4-2-2 1.4-2-.6-1.4-2.4-.5V8.6l2.4-.5.6-1.4-1.4-2 2-2 2 1.4 1.4-.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="10" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span class="word">{w.open.text}</span></button>
