---
// Index of the dev-only pages. Served at /dev/ in `astro dev`, and in a build
// only with WORKSHOP_DEV_PAGES=1 (integrations/dev-pages.ts).
import { join } from 'node:path';
import { devPagePattern, listDevPages } from '../../integrations/dev-pages.ts';

const pages = listDevPages(join(process.cwd(), 'src/dev-pages')).map((p) => ({
  file: p,
  url: `${devPagePattern(p)}/`,
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Dev pages</title>
  </head>
  <body>
    <h1>Dev pages</h1>
    <ul>
      {pages.map((p) => <li><a href={p.url}>{p.url}</a> <code>src/dev-pages/{p.file}</code></li>)}
    </ul>
  </body>
</html>
