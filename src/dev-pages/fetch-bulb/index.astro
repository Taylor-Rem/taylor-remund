---
// Review page for Fetch, take A (the Bulb), under the real stage light.
// Query: ?view=beauty|clay|silhouette  ?dist=wide|station|close|sheet
//        ?pose=rest|curious|eager|oops|offer|deadpan  ?angle=<deg> (Fetch's turn, + toward the visitor's right)
//        ?x=&z= (where Fetch stands; default the stand-in's spot)  ?detail=low  ?seed=
// Debug: window.__fetch = { pose(p), root }.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Fetch, the Bulb</title>
    <style>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #12292c; }
      canvas { display: block; width: 100vw; height: 100vh; }
      #hud { position: fixed; left: 8px; bottom: 6px; font: 12px/1.3 monospace; color: #efe6d2; opacity: 0.7; white-space: pre; }
    </style>
  </head>
  <body>
    <canvas id="stage"></canvas>
    <div id="hud"></div>
    <script>
      import { Box3, Color, Mesh, MeshBasicMaterial, MeshStandardMaterial, Object3D, Vector3 } from 'three';
      import { hex } from '../../workshop/view/palette.ts';
      import { createStage } from '../../workshop/view/stage/index.ts';
      import { createLoop } from '../../workshop/view/stage/loop.ts';
      import { createMaterials } from '../../workshop/view/materials/index.ts';
      import { createLabels, world } from '../../workshop/view/labels/index.ts';
      import * as K from '../../workshop/view/kit/index.ts';
      import { buildFetchBulb, poseFetch, EXPRESSIONS } from '../../workshop/view/kit/pieces/fetch-bulb/index.ts';
      import type { Expression, FetchPose } from '../../workshop/view/kit/pieces/fetch-bulb/index.ts';

      const q = new URLSearchParams(location.search);
      const view = q.get('view') ?? 'beauty';
      const dist = q.get('dist') ?? 'station';
      const poseName = q.get('pose') ?? 'rest';
      const angle = Number(q.get('angle') ?? -20) * Math.PI / 180;
      const detail = q.get('detail') === 'low' ? 'low' : 'high';
      const seed = Number(q.get('seed') ?? 1);
      const fx = Number(q.get('x') ?? 3.0), fz = Number(q.get('z') ?? 1.25);

      const canvas = document.getElementById('stage') as HTMLCanvasElement;
      const stage = createStage(canvas, { tier: 'high', reducedMotion: false, preserveDrawingBuffer: true, camera: { stationSize: 0.9 } });
      const materials = createMaterials({ tier: 'high' });
      const labels = await createLabels({ anisotropy: stage.renderer.capabilities.getMaxAnisotropy() });
      materials.setLabels(labels);
      const nameKey = labels.tape(world.names.fetch, 'black', { capHeight: 0.026 });

      // ---- the bench and the back wall, from the kit, in the real materials ----
      const env = new Object3D();
      stage.scene.add(env);
      const bench = K.piece('bench', { ao: false });
      for (let i = 0; i < 8; i++) {
        const g = K.roundedBox({ w: 20, h: 0.3, d: 1.22, r: 0.03, detail: 'low' });
        K.transform(g, K.T(0, -0.3, -5 + 1.25 * (i + 0.5)));
        bench.add(K.large(K.part('wood', g, 'wood', { seed: i, jitter: 0.06 })));
      }
      for (let i = 0; i < 14; i++) {
        const g = K.roundedBox({ w: 20 / 14 - 0.03, h: 7, d: 0.2, r: 0.02, detail: 'low' });
        K.transform(g, K.T(-10 + (20 / 14) * (i + 0.5), -0.1, -5.3));
        bench.add(K.large(K.part('wood', g, 'wood', { seed: 40 + i, shade: 0.45, jitter: 0.08 })));
      }
      env.add(K.realize(bench.build(), materials));

      const clay = new MeshStandardMaterial({ color: new Color(hex('paper')).multiplyScalar(0.6), roughness: 0.6 });
      const black = new MeshBasicMaterial({ color: 0x000000 });

      const sheet = dist === 'sheet';
      const poses: Array<Partial<FetchPose>> = sheet
        ? (['curious', 'eager', 'oops', 'offer', 'deadpan'] as Expression[]).map((e) => EXPRESSIONS[e])
        : [poseName in EXPRESSIONS ? EXPRESSIONS[poseName as Expression] : {}];
      const fetches: Object3D[] = [];
      let tris = 0;
      poses.forEach((p, i) => {
        const piece = buildFetchBulb({ seed: seed + i * (sheet ? 0 : 1), detail, nameKey, nameSize: labels.size(nameKey) });
        tris = piece.triangles;
        const o = K.realize(piece, materials);
        poseFetch(o, p);
        const x = sheet ? fx + (i - 2) * 1.08 : fx;
        o.position.set(x, 0, fz);
        o.rotation.y = angle;
        if (view === 'clay') o.traverse((m) => { if ((m as Mesh).isMesh && (m as Mesh).userData['kitMaterial'] !== 'bulb') (m as Mesh).material = clay; });
        if (view === 'silhouette') o.traverse((m) => { if ((m as Mesh).isMesh) (m as Mesh).material = black; });
        stage.scene.add(o);
        fetches.push(o);
      });
      if (view === 'silhouette') {
        env.visible = false;
        stage.scene.background = new Color(hex('paper'));
        stage.post = false;
      }

      // ---- framing ----
      const wideBox = new Box3(new Vector3(-7.6, -0.4, -5.0), new Vector3(6.8, 5.6, 4.6));
      stage.camera.setSubject(wideBox, { edge: { y: 0, z: 5.2 } });
      const around = (cx: number, w: number, h: number): Box3 => new Box3(new Vector3(cx - w / 2, 0, fz - w * 0.35), new Vector3(cx + w / 2, h, fz + w * 0.35));
      const boxes: Record<string, Box3> = {
        station: around(fx, 1.7, 1.55),
        close: new Box3(new Vector3(fx - 0.42, 0.45, fz - 0.2), new Vector3(fx + 0.42, 1.12, fz + 0.4)),
        sheet: around(fx, 5.4, 1.5),
        sil40: around(fx, 1.5, 1.5),
      };
      const b = boxes[dist];
      if (b) {
        stage.camera.focusOn(b.getCenter(new Vector3()));
        stage.camera.cutTo(stage.camera.frame(b));
      } else {
        stage.camera.focusOn(new Vector3(0.4, 0.5, 1.2));
        stage.camera.cutTo(stage.camera.home());
      }

      (document.getElementById('hud') as HTMLElement).textContent = `fetch-bulb view=${view} dist=${dist} pose=${poseName} triangles=${tris}`;
      if (q.get('hud') === '0') (document.getElementById('hud') as HTMLElement).style.display = 'none';

      let frames = 0;
      const loop = createLoop({
        step() {},
        render(info) {
          materials.update(info.time ?? 0);
          stage.render({ dt: info.dt });
          if (++frames === 10) requestAnimationFrame(() => { (window as unknown as { __ready: boolean }).__ready = true; });
        },
      });
      loop.start();
      (window as unknown as { __fetch: unknown }).__fetch = { pose: (p: Partial<FetchPose>) => fetches.forEach((f) => poseFetch(f, p)), root: fetches[0] };
    </script>
  </body>
</html>
