---
// /dev/bench/ (briefs L1, A1; REWRITE.md § C, § G "P2"): the whole bench, 18 × 10,
// stood up from its station files (view/bench/stations/*.ts, one per station;
// how to add one: the note at the top of view/bench.ts): every piece that exists
// in its place, the crew drawn 1.5×, and grey clay at the footprint of each piece
// still being built, each with its name over it so a still explains itself. Dev-only.
//
// Query:
//   ?shot=home|button|fetch|patch|cord   the camera (default home: wide, or the cluster on a portrait phone)
//   ?view=wide|phone   force a framing
//   ?plan=1            straight down, near-orthographic, with a unit grid, coordinates and every footprint
//   ?names=0           no stand-in names
//   ?crew=1.25         draw the crew at another scale (default view/bench.ts CREW_SCALE)
//   ?seat=0.65         test a lower seat: the P1 stool sunk into the bench so its top stands this high, Patch on it
//   ?room=0            without the room (P1's bench top and 21-wide wall, the stage's fall-off)
//   ?shot=left|right   panned as far as a visitor can to each end at the home zoom
//   ?hud=0  ?debug=1  ?manual=1  ?seed=N  ?tier=high|low  ?physics=stub
//
// Picture first (B1, REWRITE.md § B3, § E6): by default the page starts from
// the bench's still picture (src/dev-pages/bench/, rendered from this page by
// `node scripts/poster.ts --set src/dev-pages/bench/posters.json --page /dev/bench/`),
// dim, warming up as the stage loads, then the live stage takes over from the
// picture's own camera and state. The engine, the fonts, the label worker and
// the bake table start loading at the first moment. On this path the HUD and
// the stand-in names are off unless asked for (?hud=1, ?names=1): they are
// not in the picture. ?manual=1, ?plan=1 and ?direct=1 boot directly, as
// before (captures, check-bench). Poster script hooks: ?band=i, ?hold=1,
// window.__handoff (shell/loader.ts).
// Hooks: window.__bench (the workshop, measure(): label capitals in px, Fetch's
//   height in px, draw calls, triangles; goto(step, shot); stillPair()).
//
// Capture (from the repo root):
//   node scripts/capture.ts "/dev/bench/?hud=0" --out shots/bench/home.png
//   node scripts/capture.ts "/dev/bench/?hud=0&plan=1" --out shots/bench/plan.png
//   node scripts/check-bench.ts
import StageHead from '../workshop/shell/StageHead.astro';
import StagePicture from '../workshop/shell/StagePicture.astro';
import type { PosterSet } from '../workshop/shell/poster.ts';
import postersJson from './bench/posters.json';
import wasmUrl from '@dimforge/rapier3d/rapier_wasm3d_bg.wasm?url';
import bakeUrl from '../workshop/view/kit/bake-table.bin?url';
import workerUrl from '../workshop/view/labels/worker.ts?worker&url';
import { FACES } from '../workshop/view/labels/fonts.ts';

const posters = postersJson as unknown as PosterSet;
const files = import.meta.glob<string>('./bench/*.{avif,jpg}', { query: '?url', import: 'default', eager: true });
// what the stage fetches once its code runs, asked for at once: the engine's wasm (the longest download, low
// priority so the code and the picture go first), the bake table, the label painters' script, the fonts
// (low: they must not slow the picture or the code; nothing else wants the line by then)
const preload = [
  { href: wasmUrl, priority: 'low' as const },
  { href: bakeUrl, priority: 'low' as const },
  { href: workerUrl, priority: 'low' as const },
  ...Object.values(FACES).map((f) => ({ href: `/fonts/${f.file}`, priority: 'low' as const })),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <meta name="robots" content="noindex" />
    <title>Bench</title>
    <StageHead preload={preload} posters={{ set: posters, files, dir: './bench/' }} />
    <style>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #12292c; overscroll-behavior: none; }
      .stage-root { background: #12292c; }
      canvas#over { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; }
      #hud {
        position: fixed; left: 8px; bottom: 6px; font: 11px/1.4 ui-monospace, Menlo, monospace; color: #bfe3d8;
        opacity: 0.8; white-space: pre; pointer-events: none; text-shadow: 0 0 3px #000;
      }
    </style>
  </head>
  <body>
    <StagePicture set={posters} files={files} dir="./bench/" />
    <canvas id="over"></canvas>
    <div id="hud"></div>
    <script>
      // first, on its own (a small chunk): the engine, the fonts and the label painters start now
      import { startEarly } from '../workshop/shell/early.ts';
      startEarly();
    </script>
    <script>
      import { Box3, Group, Matrix4, Vector3, type Mesh, type Object3D, type BufferAttribute } from 'three';
      import { bootWorkshop, type BootOptions } from '../workshop/shell/boot.ts';
      import { loadStage } from '../workshop/shell/loader.ts';
      import type { PosterSet } from '../workshop/shell/poster.ts';
      import { earlyPhysics } from '../workshop/shell/early.ts';
      import { installDebugHooks } from '../workshop/view/stage/debug.ts';
      import { LOOK } from '../workshop/view/stage/index.ts';
      import { createStubPhysics } from '../workshop/sim/index.ts';
      import type { SimEvent, Vec3 } from '../workshop/sim/index.ts';
      import { bench as BENCH_SCENE } from '../workshop/sim/scenes/bench.ts';
      import { loadBench, homeBox, homeEdge, FRAMING, LAYOUT, spotBox, type Spot, type StationKey } from '../workshop/view/bench.ts';
      import { staticBox } from '../workshop/view/vignette.ts';
      import { lanePath } from '../workshop/sim/path.ts';
      import { FETCH_TUNING, fetchStand } from '../workshop/sim/crew/fetch.ts';
      import type { View } from '../workshop/view/stage/camera.ts';

      const q = new URLSearchParams(location.search);
      const tier = q.get('tier') === 'low' ? 'low' : 'high';
      const manual = q.get('manual') === '1';
      const seed = Number(q.get('seed') ?? 1);
      const plan = q.get('plan') === '1';
      // the picture-first path (default), or a direct boot (captures, check-bench, the plan view)
      const direct = manual || plan || q.get('direct') === '1';
      const band = q.get('band');
      const hold = q.get('hold') === '1' || band !== null;
      const hudOn = direct ? q.get('hud') !== '0' : q.get('hud') === '1';
      const namesOn = direct ? q.get('names') !== '0' : q.get('names') === '1';
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('stage') as HTMLCanvasElement;
      const over = document.getElementById('over') as HTMLCanvasElement;
      const hud = document.getElementById('hud')!;

      /** Names for the review overlay (scaffolding: never on the stage). */
      const NAMES: Record<StationKey, string> = {
        toolwall: 'tool wall', lamp: 'lamp clamp', sign: 'sign', window: 'WINDOW', board: 'switchboard', stool: 'stool',
        storefront: 'STOREFRONT', bayNext: 'RESERVED bay', bayInspection: 'RESERVED: INSPECTION bay', undo: 'UNDO lever', phone: 'phone', platen: 'PLATEN',
        shipped: 'SHIPPED (P4): pallets', mailbox: 'MAILBOX + résumé clipboard (P4)', hatch: "REVERT's hatch", revert: 'REVERT', button: 'Button', stack: 'crate stack',
        lane: "Fetch's lane", belt: 'belt', striker: 'STRIKER', dock: 'DOCK', chute: 'RETURN CHUTE',
      };

      const crew = q.get('crew') ? Number(q.get('crew')) : undefined;
      const withRoom = q.get('room') !== '0';
      // the room shows (ROOM brief: at the stage's 0.9 everything below the bench top is erased and the bench floats)
      if (withRoom) Object.assign(LOOK.fog, { drop: 5.5 });
      const seat = q.get('seat') ? Number(q.get('seat')) : undefined;
      const root = document.getElementById('stage-root')!;
      if (direct) root.classList.add('direct');
      const posterInfo = (window as unknown as { __posters: { urls: Record<string, string>; manifest: PosterSet; ready: boolean } }).__posters;
      if (hold) {
        // held before the swap (the poster script, the proof): ready once the held frame is drawn
        const poll = (): void => {
          const h = (window as unknown as { __handoff?: { phase: string } }).__handoff;
          if (h?.phase === 'held-picture' || h?.phase === 'failed') window.__ready = true;
          else requestAnimationFrame(poll);
        };
        poll();
      }
      // the scene's loading is the loader's first phase (its progress warms the picture)
      let bench!: Awaited<ReturnType<typeof loadBench>>;
      const prepare = async (): Promise<void> => {
        bench = await loadBench({ scene: BENCH_SCENE, seed, room: withRoom, ...(crew ? { crewScale: crew } : {}), ...(seat !== undefined ? { seat } : {}) });
      };
      if (direct) await prepare();
      const portrait = (): boolean => !plan && (q.get('view') === 'phone' || (q.get('view') !== 'wide' && innerWidth < innerHeight));

      const shots: Record<string, () => Box3> = {
        button: () => {
          const c = staticBox(bench.scene, 'console')!.getCenter(new Vector3());
          return new Box3(new Vector3(c.x - 1.5, 0, c.z - 1.0), new Vector3(c.x + 1.6, 1.4, c.z + 1.4));
        },
        fetch: () => {
          const m = bench.world()?.motion('fetch');
          const p = m ? m.pose.p : ([bench.scene.runner.lane.points[0]![0], 0.5, bench.scene.runner.lane.points[0]![1]] as Vec3);
          return new Box3(new Vector3(p[0] - 1.2, 0, p[2] - 0.6), new Vector3(p[0] + 1.2, 1.5, p[2] + 0.7));
        },
        patch: () => {
          const s = bench.fit.stool.seat;
          return new Box3(new Vector3(s[0] - 2.0, 0, s[2] - 1.0), new Vector3(s[0] + 0.9, 2.5, s[2] + 0.6));
        },
        cord: () => {
          const j = bench.fit.board.jacks;
          return new Box3(new Vector3(j.storefront[0] - 1.6, 0, j.storefront[2] - 0.4), new Vector3(j.lamp[0] + 1.4, 2.2, j.storefront[2] + 1.8));
        },
      };

      const log: { step: number; e: SimEvent }[] = [];
      let booted = false;
      const planBox = new Box3(new Vector3(-9.8, 0, -5.6), new Vector3(9.8, 0.01, 5.4));
      const bootOptions = (): Omit<BootOptions, 'manual' | 'onProgress'> => ({
        tier,
        reducedMotion,
        seed,
        physics: q.get('physics') === 'stub' ? async () => createStubPhysics() : earlyPhysics,
        scene: bench.scene,
        // the event log and the overlay ride as a last station view, not on onFrame: the boot's warm frames call
        // onFrame before it has made the workshop it passes (boot.ts, since cbf355b), which throws
        stations: [
          ...bench.stations,
          () => ({
            root: new Group(),
            update(frame) {
              for (const e of frame.events) log.push({ step: frame.world.step, e });
              if (log.length > 4000) log.splice(0, log.length - 4000);
              if (booted) drawOverlay();
            },
            dispose() {},
          }),
        ],
        // measurement switches (scripts/perf.ts, H1): ?timer=1 GPU ms per pass, ?gpusync=1 wait for the GPU each frame
        stage: { preserveDrawingBuffer: q.get('preserve') === '1', gpuTimer: q.get('timer') === '1', syncGpu: q.get('gpusync') === '1', camera: plan ? { fov: 1.2, pitch: 89.6, margin: 0.03 } : { ...FRAMING.lens } },
        frameCamera(stage, scene) {
          if (plan) {
            stage.camera.setSubject(planBox, { bounds: planBox });
            Object.assign(LOOK.focus, { max: 0 });
            stage.camera.cutTo(stage.camera.home());
            return;
          }
          const aspect = portrait() ? 0.5 : canvas.clientWidth / Math.max(1, canvas.clientHeight);
          const edge = homeEdge(aspect, scene.bench);
          stage.camera.stationSize = 1.9;
          stage.camera.setSubject(homeBox(aspect), { edge, bounds: new Box3(new Vector3(...FRAMING.bounds.min), new Vector3(...FRAMING.bounds.max)) });
          stage.camera.focusOn({ x: FRAMING.focus[0], y: FRAMING.focus[1], z: FRAMING.focus[2] });
          Object.assign(LOOK.focus, FRAMING.blur);
          stage.camera.cutTo(stage.camera.home());
        },
        onFrameRequest(id, stage) {
          const box = id === 'button' ? shots.button!() : id === 'fetch' ? shots.fetch!() : id === 'cord' || id?.startsWith('jack') ? shots.cord!() : null;
          if (box) stage.camera.easeTo(stage.camera.frame(box));
          else stage.camera.easeTo(stage.camera.home());
        },
      });
      const set = posterInfo.manifest;
      const started = direct
        ? await bootWorkshop(canvas, { ...bootOptions(), manual })
        : await loadStage({
            root,
            canvas,
            img: root.querySelector('img.poster'),
            posters: band === null && posterInfo.ready ? set : null,
            url: (file) => posterInfo.urls[file] ?? '',
            reducedMotion,
            hold,
            ...(band !== null ? { renderBand: { narrowest: Number(band) === 0 ? set.narrowest : set.posters[Number(band)]!.minAspect, step: set.step, settle: set.settle } } : {}),
            async prepare(progress) {
              await prepare();
              progress(1);
              return bootOptions();
            },
          });
      if (!started) {
        // the stage could not start: the picture stays (shell/loader.ts)
        window.__ready = true;
        throw new Error('bench: the stage failed to start');
      }
      const ws = started;
      booted = true;
      const views: Record<string, View> = { home: ws.stage.camera.home() };
      installDebugHooks(ws.stage, ws.loop, views);

      const applyShot = (name: string): void => {
        const f = shots[name];
        if ((name === 'left' || name === 'right') && !plan) {
          // zoomed in halfway, then panned as far as the limits let a visitor go toward that end and the front
          const h = ws.stage.camera.home();
          ws.stage.camera.cutTo({ focus: [name === 'left' ? -30 : 30, h.focus[1], h.focus[2] + 20], zoom: 0.5 });
          ws.stage.camera.focusOn(null);
          return;
        }
        if (!f || plan) {
          ws.stage.camera.cutTo(ws.stage.camera.home());
          if (!plan) ws.stage.camera.focusOn({ x: FRAMING.focus[0], y: FRAMING.focus[1], z: FRAMING.focus[2] });
          return;
        }
        const b = f();
        ws.stage.camera.cutTo(ws.stage.camera.frame(b));
        ws.stage.camera.focusOn(b.getCenter(new Vector3()));
      };

      // ── projection and the overlay (names; in plan, the grid and every footprint) ──
      function project(p: Vector3): { x: number; y: number; z: number } {
        const s = ws.stage.camera.worldToScreen(p);
        return { x: ((s.x + 1) / 2) * canvas.clientWidth, y: ((1 - s.y) / 2) * canvas.clientHeight, z: s.z };
      }
      function drawOverlay(): void {
        const dpr = devicePixelRatio || 1;
        const W = canvas.clientWidth, H = canvas.clientHeight;
        if (over.width !== Math.round(W * dpr)) over.width = Math.round(W * dpr);
        if (over.height !== Math.round(H * dpr)) over.height = Math.round(H * dpr);
        const g = over.getContext('2d')!;
        g.setTransform(dpr, 0, 0, dpr, 0, 0);
        g.clearRect(0, 0, W, H);
        const P = (x: number, y: number, z: number) => project(new Vector3(x, y, z));
        if (plan) {
          g.lineWidth = 1;
          for (let x = -9; x <= 9; x++) {
            const a = P(x, 0, -5), b = P(x, 0, 5);
            g.strokeStyle = x === 0 ? 'rgba(255,210,122,0.6)' : 'rgba(191,227,216,0.22)';
            g.beginPath(); g.moveTo(a.x, a.y); g.lineTo(b.x, b.y); g.stroke();
          }
          for (let z = -5; z <= 5; z++) {
            const a = P(-9, 0, z), b = P(9, 0, z);
            g.strokeStyle = z === 0 ? 'rgba(255,210,122,0.6)' : 'rgba(191,227,216,0.22)';
            g.beginPath(); g.moveTo(a.x, a.y); g.lineTo(b.x, b.y); g.stroke();
          }
          g.font = '11px ui-monospace, Menlo, monospace';
          g.fillStyle = 'rgba(255,230,180,0.9)';
          for (let x = -9; x <= 9; x++) { const p = P(x, 0, 5); g.fillText(String(x), p.x - 4, p.y + 13); }
          for (let z = -5; z <= 5; z++) { const p = P(-9, 0, z); g.fillText(`z ${z}`, p.x - 34, p.y + 4); }
          for (const [key, s] of Object.entries(LAYOUT.stations) as Array<[StationKey, Spot]>) {
            const b = spotBox(s);
            const c = Math.cos((s.yaw * Math.PI) / 180), n = Math.sin((s.yaw * Math.PI) / 180);
            const onWall = s.z <= -5;
            const cz = onWall ? -5 + s.d / 2 : s.z;
            const pts = [[-1, -1], [1, -1], [1, 1], [-1, 1]].map(([u, v]) => {
              const lx = (u! * s.w) / 2, lz = (v! * s.d) / 2;
              return P(s.x + lx * c + lz * n, 0, cz - lx * n + lz * c);
            });
            g.strokeStyle = s.fill === 'clay' ? 'rgba(255,140,90,0.95)' : s.fill === 'tape' ? 'rgba(227,178,28,0.95)' : 'rgba(150,220,255,0.95)';
            g.lineWidth = 1.5;
            g.beginPath(); pts.forEach((p, i) => (i ? g.lineTo(p.x, p.y) : g.moveTo(p.x, p.y))); g.closePath(); g.stroke();
            const m = P(s.x, 0, onWall ? -5.0 : cz);
            g.fillStyle = 'rgba(255,255,255,0.95)';
            g.font = 'bold 11px ui-monospace, Menlo, monospace';
            const t = NAMES[key];
            g.fillText(t, m.x - g.measureText(t).width / 2, m.y + (onWall ? -6 : 4));
            void b;
          }
          // Fetch's path (the ridden line, corners rounded) and where it stands for each thing it handles, with the distance
          const sc = bench.scene;
          const path = lanePath(sc.runner.lane.points, FETCH_TUNING.cornerRadius * (sc.crewScale ?? 1));
          g.strokeStyle = 'rgba(255,90,200,0.95)';
          g.lineWidth = 2;
          g.beginPath();
          for (let i = 0; i <= 120; i++) {
            const [x, z] = path.at((path.length * i) / 120);
            const q = P(x, 0, z);
            if (i) g.lineTo(q.x, q.y); else g.moveTo(q.x, q.y);
          }
          g.stroke();
          const lap = sc.runner.attract, rounds = sc.runner.rounds;
          const tray = lap ? sc.mouths?.find((m) => m.id === lap.tray) : undefined;
          const feed = rounds ? sc.mouths?.find((m) => m.id === rounds.mouth) : undefined;
          const things: Array<['stack' | 'tray' | 'phone' | 'feed', number, number]> = [];
          if (rounds) things.push(['stack', rounds.stack[0], rounds.stack[1]]);
          if (tray) things.push(['tray', tray.drop[0], tray.drop[2]]);
          if (lap) things.push(['phone', lap.phone[0], lap.phone[2]]);
          if (feed) things.push(['feed', feed.drop[0], feed.drop[2]]);
          g.font = 'bold 12px ui-monospace, Menlo, monospace';
          for (const [what, px, pz] of things) {
            const st = fetchStand(sc, what, px, pz);
            const a = P(st.at[0], 0, st.at[1]), b = P(px, 0, pz);
            g.strokeStyle = 'rgba(255,90,200,0.95)';
            g.lineWidth = 1.5;
            g.beginPath(); g.moveTo(a.x, a.y); g.lineTo(b.x, b.y); g.stroke();
            g.fillStyle = 'rgba(255,90,200,1)';
            g.beginPath(); g.arc(a.x, a.y, 5, 0, Math.PI * 2); g.fill();
            g.beginPath(); g.arc(b.x, b.y, 3, 0, Math.PI * 2); g.fill();
            const label = `${what} ${st.d.toFixed(2)}`;
            g.fillStyle = 'rgba(18,41,44,0.8)';
            const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
            g.fillRect(mx + 4, my - 12, g.measureText(label).width + 6, 16);
            g.fillStyle = 'rgba(255,200,240,1)';
            g.fillText(label, mx + 7, my);
          }
          return;
        }
        if (!namesOn) return;
        g.font = 'bold 12px ui-monospace, Menlo, monospace';
        for (const [key, s] of Object.entries(LAYOUT.stations) as Array<[StationKey, Spot]>) {
          if (s.fill === 'piece' || key === 'lane') continue;
          const b = spotBox(s);
          const c = b.getCenter(new Vector3());
          const p = P(c.x, b.max.y + 0.05, s.z <= -5 ? b.max.z : c.z);
          if (p.z > 1) continue;
          const t = NAMES[key];
          const w = g.measureText(t).width;
          g.fillStyle = 'rgba(18,41,44,0.7)';
          g.fillRect(p.x - w / 2 - 4, p.y - 22, w + 8, 17);
          g.fillStyle = 'rgba(255,230,180,0.95)';
          g.fillText(t, p.x - w / 2, p.y - 9);
        }
      }

      // ── measuring: label capitals in px at this view, Fetch's height in px, draw calls, triangles ──
      interface LabelCap { key: string; register: string; text: string; px: number; onScreen: boolean }
      const v0 = new Vector3(), v1 = new Vector3(), v2 = new Vector3();
      function measureLabels(): LabelCap[] {
        const out: LabelCap[] = [];
        ws.stage.scene.updateMatrixWorld(true);
        ws.stage.scene.traverse((o: Object3D) => {
          const m = o as Mesh;
          if (!m.isMesh || !m.visible) return;
          for (let a: Object3D | null = m; a; a = a.parent) if (!a.visible) return;
          const mat = m.userData['kitMaterial'] as string | undefined;
          if (!mat) return;
          const tag = `.${mat}.`;
          const at = m.name.indexOf(tag);
          if (at < 0) return;
          // label quads merged on an atlas page (T1): one measurement per label, over its own vertices
          const merged = ((m.geometry.userData['kitSources'] ?? []) as Array<{ start: number; count: number; texture?: string }>).filter((s) => s.texture?.includes('|'));
          if (merged.length && !m.name.slice(at + tag.length).includes('|')) {
            for (const s of merged) measureOne(m, s.texture!, s.start, s.count);
            return;
          }
          let key = m.name.slice(at + tag.length);
          if (!key.includes('|')) return;
          // a material variant may follow the key (".noshadow"): take the longest prefix the labels know
          for (;;) {
            try {
              ws.labels.capHeight(key);
              break;
            } catch {
              const cut = key.lastIndexOf('.');
              if (cut <= key.indexOf('|')) return;
              key = key.slice(0, cut);
            }
          }
          measureOne(m, key, 0, Infinity);
        });
        function measureOne(m: Mesh, key: string, start: number, count: number): void {
          const cap = ws.labels.capHeight(key);
          const size = ws.labels.size(key);
          const register = key.split(/[:@|]/)[0]!;
          const text = key.slice(key.indexOf('|') + 1);
          const g = m.geometry;
          const pos = g.getAttribute('position') as BufferAttribute;
          const uv = g.getAttribute('uv') as BufferAttribute | undefined;
          if (!uv) return;
          const idx = g.index;
          const tris = idx ? idx.count / 3 : pos.count / 3;
          const per: number[] = [];
          let on = false;
          for (let t = 0; t < tris; t++) {
            const i0 = idx ? idx.getX(t * 3) : t * 3, i1 = idx ? idx.getX(t * 3 + 1) : t * 3 + 1, i2 = idx ? idx.getX(t * 3 + 2) : t * 3 + 2;
            if (i0 < start || i0 >= start + count) continue;
            const s0 = project(v0.fromBufferAttribute(pos, i0).applyMatrix4(m.matrixWorld));
            const s1 = project(v1.fromBufferAttribute(pos, i1).applyMatrix4(m.matrixWorld));
            const s2 = project(v2.fromBufferAttribute(pos, i2).applyMatrix4(m.matrixWorld));
            const du1 = uv.getX(i1) - uv.getX(i0), dv1 = uv.getY(i1) - uv.getY(i0);
            const du2 = uv.getX(i2) - uv.getX(i0), dv2 = uv.getY(i2) - uv.getY(i0);
            const det = du1 * dv2 - du2 * dv1;
            if (Math.abs(det) < 1e-9) continue;
            const ax = s1.x - s0.x, ay = s1.y - s0.y, bx = s2.x - s0.x, by = s2.y - s0.y;
            const jvx = (-du2 * ax + du1 * bx) / det, jvy = (-du2 * ay + du1 * by) / det;
            per.push(Math.hypot(jvx, jvy));
            if ([s0, s1, s2].some((s) => s.x >= 0 && s.x <= canvas.clientWidth && s.y >= 0 && s.y <= canvas.clientHeight && s.z < 1)) on = true;
          }
          if (!per.length) return;
          per.sort((a, b) => a - b);
          const pxPerV = per[Math.floor(per.length / 2)]!;
          out.push({ key, register, text, px: Math.round(pxPerV * (cap / size.h) * 10) / 10, onScreen: on });
        }
        return out;
      }
      /** Fetch's drawn height on screen (px): its piece bounds, scaled and placed as drawn, projected. */
      function fetchPx(): number | null {
        const body = ws.stage.scene.getObjectByName('fetch:body');
        const b = bench.fetchBounds;
        if (!body || !b) return null;
        body.updateMatrixWorld(true);
        const m = new Matrix4().copy(body.matrixWorld);
        let lo = Infinity, hi = -Infinity;
        for (let i = 0; i < 8; i++) {
          const p = project(new Vector3(i & 1 ? b.max.x : b.min.x, i & 2 ? b.max.y : b.min.y, i & 4 ? b.max.z : b.min.z).applyMatrix4(m));
          lo = Math.min(lo, p.y);
          hi = Math.max(hi, p.y);
        }
        // the vertical extent of the box overstates by its depth's slant; take the base-to-top line through its centre
        const c = new Vector3((b.min.x + b.max.x) / 2, 0, (b.min.z + b.max.z) / 2);
        const t = c.clone().setY(b.max.y);
        const pb = project(c.applyMatrix4(m)), pt = project(t.applyMatrix4(m));
        return Math.round(Math.abs(pb.y - pt.y) * 10) / 10 || Math.round((hi - lo) * 10) / 10;
      }
      /** A base-to-crown line through a box's centre, as drawn by `m`, in px. */
      function heightPx(b: Box3 | null, m: Matrix4): number | null {
        if (!b) return null;
        const c = new Vector3((b.min.x + b.max.x) / 2, Math.max(0, b.min.y), (b.min.z + b.max.z) / 2);
        const t = c.clone().setY(b.max.y);
        return Math.round(Math.abs(project(c.applyMatrix4(m)).y - project(t.applyMatrix4(m)).y) * 10) / 10;
      }
      /** Fetch without its aerial and pennant; Patch from its seat to the top of its ears (px). */
      function crewPx(): { fetchBody: number | null; patch: number | null } {
        const body = ws.stage.scene.getObjectByName('fetch:body');
        let patchRoot: Object3D | null = null;
        for (const c of ws.stage.scene.children) if (c.name === 'patch') patchRoot = c;
        body?.updateMatrixWorld(true);
        patchRoot?.updateMatrixWorld(true);
        return {
          fetchBody: body ? heightPx(bench.fetchBodyBounds, body.matrixWorld) : null,
          patch: patchRoot && bench.patchBounds ? heightPx(new Box3(new Vector3(0, 0, 0), new Vector3(0, bench.patchBounds.max.y, 0)), patchRoot.matrixWorld) : null,
        };
      }
      /** The belt's dial plate (r 0.1) and lever plate (0.26 × 0.11) on screen: width × height in px. */
      function handlesPx(): Record<string, [number, number] | null> {
        const size = (m: Matrix4 | null, hw: number, hh: number): [number, number] | null => {
          if (!m) return null;
          const P = (x: number, y: number) => project(new Vector3(x, y, 0).applyMatrix4(m));
          const xs = [P(-hw, 0), P(hw, 0), P(0, -hh), P(0, hh)];
          const w = Math.max(...xs.map((p) => p.x)) - Math.min(...xs.map((p) => p.x));
          const h = Math.max(...xs.map((p) => p.y)) - Math.min(...xs.map((p) => p.y));
          return [Math.round(w * 10) / 10, Math.round(h * 10) / 10];
        };
        return { dial: size(bench.handles.dial, 0.1, 0.1), lever: size(bench.handles.lever, 0.13, 0.055) };
      }
      /** The front corners' distance inside the frame's sides, and the front edge's height over the frame's bottom (px). */
      function framePx(): { left: number; right: number; under: number } {
        const l = project(new Vector3(LAYOUT.bench.minX, 0, LAYOUT.bench.maxZ)), r = project(new Vector3(LAYOUT.bench.maxX, 0, LAYOUT.bench.maxZ));
        const e = project(new Vector3(0, 0, LAYOUT.bench.maxZ));
        return { left: Math.round(l.x), right: Math.round(canvas.clientWidth - r.x), under: Math.round(canvas.clientHeight - e.y) };
      }
      /** Every station's footprint on screen: is it fully in frame? */
      function inFrame(): Record<string, boolean> {
        const out: Record<string, boolean> = {};
        for (const [key, s] of Object.entries(LAYOUT.stations) as Array<[StationKey, Spot]>) {
          const b = spotBox(s);
          out[key] = [0, 1, 2, 3, 4, 5, 6, 7].every((i) => {
            const p = ws.stage.camera.worldToScreen(new Vector3(i & 1 ? b.max.x : b.min.x, i & 2 ? b.max.y : b.min.y, i & 4 ? b.max.z : b.min.z));
            return Math.abs(p.x) <= 1 && Math.abs(p.y) <= 1;
          });
        }
        return out;
      }

      const api = {
        ws,
        bench,
        log,
        crewScale: bench.crewScale,
        layout: () => bench.measured,
        shot: applyShot,
        measure() {
          ws.advance(0);
          const st = ws.stage.stats();
          return { labels: measureLabels(), fetchPx: fetchPx(), crew: crewPx(), handles: handlesPx(), frame_px: framePx(), crewScale: bench.crewScale, inFrame: inFrame(), scene: st.scene, frame: st.frame, renderer: st.renderer, width: canvas.clientWidth, height: canvas.clientHeight };
        },
        project: (p: Vec3) => project(new Vector3(...p)),
        goto(step: number, shot = 'home') {
          while (ws.world.step < step) ws.advance(1);
          applyShot(shot);
          for (let i = 0; i < 4; i++) ws.advance(0);
          return { step: ws.world.step, fetch: ws.world.crew('fetch')?.state };
        },
        stillPair(threshold = 2) {
          const gl = ws.stage.renderer.getContext();
          const w = gl.drawingBufferWidth, h = gl.drawingBufferHeight;
          const a = new Uint8Array(w * h * 4), b = new Uint8Array(w * h * 4);
          ws.advance(0);
          gl.readPixels(0, 0, w, h, gl.RGBA, gl.UNSIGNED_BYTE, a);
          ws.advance(0);
          gl.readPixels(0, 0, w, h, gl.RGBA, gl.UNSIGNED_BYTE, b);
          let n = 0, max = 0;
          let x0 = w, y0 = h, x1 = -1, y1 = -1;
          for (let i = 0; i < w * h; i++) {
            const d = Math.max(Math.abs(a[i * 4]! - b[i * 4]!), Math.abs(a[i * 4 + 1]! - b[i * 4 + 1]!), Math.abs(a[i * 4 + 2]! - b[i * 4 + 2]!));
            if (d > max) max = d;
            if (d > threshold) {
              n++;
              const x = i % w, y = h - 1 - Math.floor(i / w);
              if (x < x0) x0 = x;
              if (x > x1) x1 = x;
              if (y < y0) y0 = y;
              if (y > y1) y1 = y;
            }
          }
          return { width: w, height: h, differing: n, maxDelta: max, box: n ? [x0, y0, x1, y1] : null };
        },
        where(id: string) {
          const m = ws.world.motion(id);
          if (m) return project(new Vector3(...m.pose.p));
          if (id === 'button') return project(new Vector3(...bench.scene.button.at));
          const j = bench.scene.cord.jacks.find((k) => k.id === id);
          if (j) return project(new Vector3(...j.at));
          return null;
        },
      };
      (window as unknown as { __bench: typeof api }).__bench = api;
      // the census (`npm run perf -- --census`) drives any page through the vignette's hook names
      (window as unknown as { __vignette: typeof api }).__vignette = api;

      const shotName = q.get('shot');
      if (shotName && shotName !== 'home') applyShot(shotName);

      if (hudOn) {
        let n = 0;
        const tick = (): void => {
          if (++n % 15 === 0) {
            const st = ws.stage.stats();
            const ft = ws.loop.frameTimes().slice(-60);
            const ms = ft.length ? ft.reduce((a, b) => a + b, 0) / ft.length : 0;
            hud.textContent = `bench · ${plan ? 'plan' : portrait() ? 'phone' : 'wide'}   draw calls ${st.scene.calls}  tris ${st.scene.triangles}  frame ${ms.toFixed(1)} ms`;
          }
          requestAnimationFrame(tick);
        };
        tick();
      }

      if (manual) {
        ws.advance(12);
        if (shotName && shotName !== 'home') applyShot(shotName);
        for (let i = 0; i < 6; i++) ws.advance(0);
        drawOverlay();
        window.__ready = true;
      } else {
        let frames = 0;
        const ready = (): void => {
          if (++frames === 20) {
            if (shotName && shotName !== 'home') applyShot(shotName);
            window.__ready = true;
          } else requestAnimationFrame(ready);
        };
        requestAnimationFrame(ready);
      }
    </script>
  </body>
</html>
