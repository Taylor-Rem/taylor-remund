---
// /dev/pitch/ (brief C1): Pitch, the businessman airship, as a LOOK SKETCH for
// the owner's eye. He is not in the bench scene or the simulation: this page
// stands him up beside the real pieces under the stage's real light. Dev-only;
// never shipped. No visible words: the banner carries the sign's own TAYLOR
// REMUND (content), nothing else.
//
// Two modes:
//   ?mode=studio (default)  the catalogue's showcase: a slice of bench and wall, the real light
//     ?take=A|B             which take (default A)
//     ?pose=rest|proud|greet|carry|strain|lower|present
//     ?yaw=<deg>            his turn (0: nose to the visitor; 90: nose to the visitor's right)
//     ?frame=close|face|crew|station   the camera (face: his head; crew: beside Fetch and Patch)
//     ?crew=1               Fetch and Patch beside him (frame=crew)
//     ?takes=1              both takes side by side (the sheet)
//     ?sil=1                black silhouettes on white: Fetch, Revert, Patch, Pitch A, Pitch B (the 40 px test)
//     ?idle=1               a slow bob, the propeller turning, the tie a beat late (still under reduced motion)
//     ?lamp=0..1  ?manual=1
//   ?mode=bench             the whole bench (shell/bench-stage.ts, booted directly), with him in it
//     ?at=moor|carry|lower|banner   where he is: at his mooring mast at the bench's left end, over the
//                           middle with a small crate on his hook, lowering a crate to Fetch's lane,
//                           or towing the banner
//     ?take=A|B  ?lamp=0  ?view=phone|wide  ?shot=<bench shot>
// Hooks: window.__pitch { show, ws, stats() } ; window.__ready after a settled frame.
//
// Capture: node scripts/capture-pitch.ts (one browser for a whole list of frames).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <meta name="robots" content="noindex" />
    <title>Pitch</title>
    <style is:global>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #12292c; }
      canvas { display: block; width: 100vw; height: 100vh; }
      #hud { position: fixed; left: 8px; bottom: 6px; font: 11px/1.35 ui-monospace, monospace; color: #bfe3d8; opacity: 0.75; white-space: pre; pointer-events: none; text-shadow: 0 0 3px #000; }
    </style>
  </head>
  <body>
    <div id="stage-root"><canvas id="stage"></canvas></div>
    <div id="hud"></div>
    <script>
      import { Box3, Color, Group, MeshBasicMaterial, Vector3, type Object3D } from 'three';
      import { mountShowcase } from '../workshop/view/catalogue/mount.ts';
      import { findPiece, buildEntry } from '../workshop/view/catalogue/registry.ts';
      import { realize, drawStats } from '../workshop/view/kit/realize.ts';
      import {
        pitch, pitchBanner, pitchMast, pivotsOf, bannerWords, posePitch, EXPRESSIONS, NEUTRAL, BODY,
        type PitchPose, type Take, type ExpressionName, type Cloth,
      } from '../workshop/view/kit/pieces/pitch/index.ts';
      import { SIGN_WORDS, CREW_SCALE } from '../workshop/view/bench.ts';

      const q = new URLSearchParams(location.search);
      const canvas = document.getElementById('stage') as HTMLCanvasElement;
      const hud = document.getElementById('hud')!;
      const mode = q.get('mode') ?? 'studio';
      const take = (['A', 'C', 'F'].includes(q.get('take') ?? '') ? q.get('take') : 'A') as Take;
      const extra = { ...(q.get('moustache') === 'pencil' || q.get('moustache') === 'handlebar' ? { moustache: q.get('moustache') as 'pencil' | 'handlebar' } : {}), ...(q.get('felt') === 'grey' || q.get('felt') === 'brown' ? { felt: q.get('felt') as 'grey' | 'brown' } : {}) };
      /** Each hat on the cloth that suits it (the sheet's choice): ?cloth= overrides. */
      const clothOf = (t: Take): Cloth => (q.get('cloth') ? cloth : t === 'F' ? 'linen' : t === 'C' ? 'charcoal' : 'flannel');
      const cloth = (['flannel', 'linen', 'charcoal'].includes(q.get('cloth') ?? '') ? q.get('cloth') : 'flannel') as Cloth;
      const poseName = (q.get('pose') ?? 'rest') as ExpressionName;
      const basePose: PitchPose = { ...(EXPRESSIONS[poseName] ?? NEUTRAL) };
      const yaw = Number(q.get('yaw') ?? 0);
      const idle = q.get('idle') === '1';
      const manual = q.get('manual') === '1';
      const lamp = q.get('lamp') !== null ? Number(q.get('lamp')) : null;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const S = CREW_SCALE;

      /** Idle motion: a slow bob and roll, the propeller turning, the tie a beat late. */
      function idlePose(p: PitchPose, t: number): PitchPose {
        if (!idle || reducedMotion) return p;
        const bob = Math.sin(t * 1.1) * 0.025;
        const pitchA = Math.sin(t * 1.1 - 0.6) * 1.6;
        return {
          ...p,
          float: p.float + bob,
          pitch: p.pitch + pitchA,
          roll: p.roll + Math.sin(t * 0.7) * 1.2,
          prop: p.prop + t * 520,
          tie: [p.tie[0] + Math.sin(t * 1.1 - 1.4) * 6, p.tie[1] + Math.sin(t * 0.7 - 1.2) * 4],
          rudder: p.rudder + Math.sin(t * 0.35) * 6,
          look: [p.look[0] + Math.sin(t * 0.4) * 8, p.look[1]],
          lid: p.lid + (Math.sin(t * 2.7) > 0.985 ? 0.5 : 0),
          car: p.car + Math.sin(t * 1.1 - 1.0) * 1.2,
        };
      }

      if (mode === 'bench') await benchMode();
      else await studioMode();

      // ───────────────────────── the studio (catalogue showcase) ─────────────────────────
      async function studioMode(): Promise<void> {
        const sil = q.get('sil') === '1';
        const frame = q.get('frame') ?? (q.get('crew') === '1' ? 'crew' : 'close');
        const posed: Array<{ obj: Object3D; take: Take; pose: PitchPose }> = [];
        const show = await mountShowcase(canvas, {
          tier: 'high',
          manual,
          ground: sil ? 'none' : 'bench',
          wall: !sil,
          ...(sil ? { post: false } : {}),
          ...(lamp !== null ? { lamp } : {}),
          onFrame(info) {
            for (const p of posed) posePitch(p.obj, idlePose(p.pose, info.time), pivotsOf(p.take));
          },
        });
        const addPitch = (t: Take, pose: PitchPose, at: { x: number; z: number; yaw: number; y?: number }, c: Cloth = clothOf(t)): Object3D => {
          const obj = show.add(pitch({ take: t, cloth: c, seed: 3, ...extra }), { x: at.x, y: at.y ?? 0, z: at.z, yaw: at.yaw, blob: sil ? 0 : 0.55 });
          obj.scale.setScalar(S);
          posePitch(obj, pose, pivotsOf(t));
          posed.push({ obj, take: t, pose });
          if (pose.banner > 0) {
            const tow = obj.getObjectByName('float');
            if (tow) {
              const ban = realize(pitchBanner({ words: bannerWords(show.labels, SIGN_WORDS) }), show.materials);
              const pv = pivotsOf(t);
              ban.position.set(pv.tow[0], pv.tow[1], pv.tow[2]);
              tow.add(ban);
            }
          }
          return obj;
        };
        const addCrew = async (name: string, opts: Record<string, unknown>, at: { x: number; z: number; yaw: number }, scale = S): Promise<Object3D | null> => {
          const e = await findPiece(name);
          if (!e) return null;
          const p = buildEntry(e, null, { seed: 1, ...opts }, show.labels);
          const o = show.add(p, { ...at, blob: sil ? 0 : 0.6 });
          o.scale.setScalar(scale);
          return o;
        };

        let subject: Box3 | null = null;
        if (sil) {
          // a row at bench scale: Fetch, Revert, Patch (on its stool), Pitch A, Pitch B
          await addCrew('fetch-porter', { pose: 'curious' }, { x: -3.2, z: 0, yaw: -25 });
          await addCrew('revert', {}, { x: -1.7, z: 0, yaw: -20 }, S / 1.25);
          await addCrew('patch-felt', { pose: 'unimpressed' }, { x: -0.2, z: 0, yaw: -10 });
          addPitch("A", basePose, { x: 1.3, z: 0, yaw: 80 });
          addPitch("F", basePose, { x: 4.6, z: 0, yaw: 80 });
          addPitch("C", basePose, { x: 2.95, z: 0, yaw: 80 });
          const black = new MeshBasicMaterial({ color: new Color(0, 0, 0) });
          show.stage.scene.overrideMaterial = black;
          show.stage.scene.background = new Color(1, 1, 1);
          show.stage.scene.environment = null;
          subject = new Box3(new Vector3(-4, 0, -0.6), new Vector3(5.6, 2.4, 0.6));
        } else if (q.get('cloths') === '1') {
          // the same gentleman in two (or three) cloths
          const list = (q.get('list') ?? 'flannel,linen').split(',') as Cloth[];
          list.forEach((c, i) => addPitch(take, basePose, { x: (i - (list.length - 1) / 2) * 2.3, z: 0, yaw: yaw || 38 }, c));
          subject = new Box3(new Vector3(-1.2 * list.length, 0, -1), new Vector3(1.2 * list.length, 2.2, 1));
        } else if (q.get('takes') === '1') {
          addPitch('A', basePose, { x: -2.3, z: 0, yaw: yaw || 38 });
          addPitch('C', basePose, { x: 0, z: 0, yaw: yaw || 38 });
          addPitch('F', basePose, { x: 2.3, z: 0, yaw: yaw || 38 });
          subject = new Box3(new Vector3(-3.4, 0, -1), new Vector3(3.4, 2.4, 1));
        } else if (frame === 'crew') {
          await addCrew('fetch-porter', { pose: 'curious' }, { x: -1.55, z: 0.3, yaw: 20 });
          await addCrew('patch-felt', { pose: 'unimpressed' }, { x: 0.05, z: -0.2, yaw: 5 });
          addPitch(take, basePose, { x: 1.75, z: 0.2, yaw: yaw || -40 });
          subject = new Box3(new Vector3(-2.4, 0, -0.8), new Vector3(2.9, 2.0, 1));
        } else {
          const obj = addPitch(take, basePose, { x: 0, z: 0, yaw });
          if (basePose.sling > 0) {
            // a crate in the cradle, hung where the hook puts it
            const size = basePose.sling >= 0.5 ? 'L' : basePose.sling >= 0.38 ? 'M' : 'S';
            const e = await findPiece('crate');
            if (e) {
              obj.updateWorldMatrix(true, true);
              const sl = obj.getObjectByName('sling');
              if (sl) {
                sl.updateWorldMatrix(true, false);
                const p = new Vector3().setFromMatrixPosition(sl.matrixWorld);
                const k = basePose.sling / 0.3;
                const edge = size === 'S' ? 0.45 : size === 'M' ? 0.6 : 0.8;
                // lift him until the crate clears the bench
                const lift = Math.max(0, 0.03 - (p.y - 0.1 * k * S - edge));
                obj.position.y += lift;
                p.y += lift;
                const top = p.y - 0.1 * k * S;
                const c = buildEntry(e, null, { size, seed: 4 }, show.labels);
                show.add(c, { x: p.x, y: top - edge, z: p.z, yaw: yaw, blob: 0.4 });
              }
            }
          }
          subject = show.boxOf(obj);
          if (frame === 'face') {
            // the head: eye, hat, collar and tie
            obj.updateWorldMatrix(true, true);
            const eye = obj.getObjectByName('eye')!;
            const c = new Vector3().setFromMatrixPosition(eye.matrixWorld);
            subject = new Box3(c.clone().add(new Vector3(-0.42, -0.62, -0.3)), c.clone().add(new Vector3(0.42, 0.28, 0.3)));
          }
        }
        if (subject) {
          const d = frame === 'station' ? 'station' : 'close';
          show.look(subject, d);
        }
        await show.labels.ready();
        show.start();
        await show.ready;
        const st = drawStats(show.world);
        hud.textContent = q.get('hud') === '0' ? '' : `pitch ${take} ${poseName}  meshes ${st.meshes} casting ${st.casting}`;
        (window as unknown as { __pitch: unknown }).__pitch = { show, stats: () => show.stage.stats() };
      }

      // ───────────────────────── the whole bench ─────────────────────────
      async function benchMode(): Promise<void> {
        const { benchGlue, startBench } = await import('../workshop/shell/bench-stage.ts');
        const { earlyPhysics } = await import('../workshop/shell/early.ts');
        const at = q.get('at') ?? 'moor';
        const pv = pivotsOf(take);
        let pose: PitchPose = { ...NEUTRAL };
        let place = { x: -8.25, y: 0, z: 1.0, yaw: 90 };
        let crate: { size: 'S' | 'M' | 'L' } | null = null;
        const mast = { x: Number(q.get('mastX') ?? -7.3), z: Number(q.get('mastZ') ?? 1.1), h: Number(q.get('mastH') ?? 0.74) };
        let mastYaw = 0;
        const hull = BODY;
        if (at === 'moor') {
          // nose in the mast's cup, swung round to face the visitor three-quarters (a moored airship weathervanes)
          pose = { ...NEUTRAL, pitch: 0, lid: 0.66, look: [10, 6] };
          const yawD = Number(q.get('moorYaw') ?? 45);
          const d = new Vector3(Math.sin((yawD * Math.PI) / 180), 0, Math.cos((yawD * Math.PI) / 180));
          mastYaw = Math.atan2(d.z, -d.x); // turns the mast's cup (+X) to face him
          const cup = new Vector3(0.07 + 0.03, mast.h - 0.04 + 0.02, 0).applyAxisAngle(new Vector3(0, 1, 0), mastYaw).multiplyScalar(S).add(new Vector3(mast.x, 0, mast.z));
          const root = cup.clone().addScaledVector(d, -(hull.nose + 0.01) * S).add(new Vector3(0, -NEUTRAL.float * S, 0));
          place = { x: root.x, y: root.y, z: root.z, yaw: yawD };
        } else if (at === 'carry') {
          pose = { ...EXPRESSIONS.carry };
          place = { x: Number(q.get('x') ?? 1.55), y: 1.35, z: Number(q.get('z') ?? 1.0), yaw: -40 };
          crate = { size: 'S' };
        } else if (at === 'lower') {
          pose = { ...EXPRESSIONS.lower };
          place = { x: Number(q.get('x') ?? 0.95), y: 1.5, z: Number(q.get('z') ?? 2.75), yaw: -30 };
          crate = { size: 'S' };
        } else if (at === 'banner') {
          pose = { ...EXPRESSIONS.present };
          place = { x: 2.9, y: 1.55, z: 1.4, yaw: 90 };
        }
        const station = () => {
          const root = new Group();
          root.name = 'pitch-sketch';
          let built = false;
          let obj: Object3D | null = null;
          return (ctx: import('../workshop/shell/boot.ts').BootViewContext) => {
            ctx.scene.add(root);
            return {
              root,
              update(frame: import('../workshop/view/types.ts').Frame) {
                if (!built) {
                  built = true;
                  obj = ctx.realize(pitch({ take, cloth: clothOf(take), seed: 3, ...extra }));
                  obj.scale.setScalar(S);
                  obj.position.set(place.x, place.y, place.z);
                  obj.rotation.y = (place.yaw * Math.PI) / 180;
                  root.add(obj);
                  posePitch(obj, pose, pv);
                  if (at === 'moor') {
                    const m = ctx.realize(pitchMast({ height: mast.h }));
                    m.scale.setScalar(S);
                    m.position.set(mast.x, 0, mast.z);
                    m.rotation.y = mastYaw;
                    root.add(m);
                  }
                  if (pose.banner > 0) {
                    const ban = ctx.realize(pitchBanner({ words: bannerWords(ctx.labels, SIGN_WORDS) }));
                    obj.getObjectByName('float')?.add(ban);
                    ban.position.set(pv.tow[0], pv.tow[1], pv.tow[2]);
                  }
                  if (crate) {
                    void (async () => {
                      const e = await findPiece('crate');
                      if (!e || !obj) return;
                      obj.updateWorldMatrix(true, true);
                      const sl = obj.getObjectByName('sling');
                      if (!sl) return;
                      sl.updateWorldMatrix(true, false);
                      const p = new Vector3().setFromMatrixPosition(sl.matrixWorld);
                      const k = pose.sling / 0.3;
                      const edge = crate!.size === 'S' ? 0.45 : crate!.size === 'M' ? 0.6 : 0.8;
                      const top = p.y - 0.1 * k * S;
                      const c = ctx.realize(buildEntry(e, null, { size: crate!.size, seed: 4 }, ctx.labels));
                      c.position.set(p.x, top - edge, p.z);
                      c.rotation.y = (place.yaw * Math.PI) / 180;
                      root.add(c);
                    })();
                  }
                }
                if (obj) posePitch(obj, idlePose(pose, frame.time), pv);
              },
              dispose() {
                root.removeFromParent();
              },
            };
          };
        };
        const glue = benchGlue({
          canvas,
          tier: 'high',
          reducedMotion,
          seed: 1,
          physics: earlyPhysics,
          room: true,
          plan: false,
          view: q.get('view') === 'phone' ? 'phone' : q.get('view') === 'wide' ? 'wide' : null,
          extraStations: [station()],
        });
        const ws = await startBench({ glue, root: document.getElementById('stage-root')!, canvas, reducedMotion, direct: true, manual: true });
        if (!ws) throw new Error('pitch: the bench did not start');
        if (lamp !== null) ws.stage.lights.setLamp({ level: lamp });
        const shot = q.get('shot');
        if (shot === 'pitch') {
          // a close framing round him (and what he carries)
          const c = new Vector3(place.x, place.y + 0.9, place.z);
          ws.stage.camera.cutTo(ws.stage.camera.frame(new Box3(c.clone().add(new Vector3(-1.5, -1.3, -0.9)), c.clone().add(new Vector3(1.5, 0.9, 0.9)))));
        } else if (shot && glue.shots[shot as keyof typeof glue.shots]) {
          const b = glue.shots[shot as keyof typeof glue.shots]();
          ws.stage.camera.cutTo(ws.stage.camera.frame(b));
        }
        ws.advance(12);
        for (let i = 0; i < 4; i++) ws.advance(0);
        await ws.labels.ready();
        for (let i = 0; i < 6; i++) ws.advance(0);
        await new Promise((r) => setTimeout(r, 300));
        for (let i = 0; i < 4; i++) ws.advance(0);
        (window as unknown as { __pitch: unknown }).__pitch = { ws, stats: () => ws.stage.stats() };
        const st = ws.stage.stats();
        hud.textContent = q.get('hud') === '0' ? '' : `bench + pitch ${take} ${at}  calls ${st.scene.calls} tris ${st.scene.triangles}`;
        if (!manual) {
          ws.loop.setManual(false);
        }
        window.__ready = true;
      }
    </script>
  </body>
</html>
