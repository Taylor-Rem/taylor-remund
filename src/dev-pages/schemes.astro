---
// /dev/schemes/ (D2, D2b): the paint schemes compared on the real bench. The bench (/dev/bench/) runs in a frame; this
// page paints its workshop in any scheme of the table at once (view/materials/scheme.ts: A to D are the dial's, E and
// F the runners-up, never on the dial) and, for the lamp, works its world the way a visitor does (the cord into LAMP and
// a text). The dial itself is on the bench, in t-components' crate: the "dial" button opens the crate and turns its
// knob one detent on through the simulation, as a hand does. The views keep the crew's and the loose parts' colours.
// Dev-only; never shipped; the letters are working names.
//
// Query (passed on to the bench, plus):
//   ?scheme=B          start in a scheme (cut); E and F too (the bench alone takes ?paint=E)
//   ?cut=1             the buttons cut instead of wiping (as with reduced motion)
//   ?ox=2.2&oy=0.7&oz=1.75   the buttons' wipe origin (default: where the dial's crate stands)
//   ?bar=0             no buttons over the picture (captures)
//   (?dial=deck is passed on: the bench draws the deck instead of the fan)
//
// Keys: 1-6 the schemes A-F (wipe), 0 back home, d the dial one on; w warm lamp, o lamp on, n lamp off, b lamp blue;
// h home, u the Button, c the switchboard, l the line.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Schemes</title>
    <style>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #12292c; }
      iframe { position: fixed; inset: 0; width: 100vw; height: 100vh; border: 0; }
      #bar { position: fixed; left: 8px; top: 8px; display: flex; gap: 4px; flex-wrap: wrap; font: 12px/1 ui-monospace, Menlo, monospace; }
      #bar button { font: inherit; padding: 6px 9px; border: 1px solid #000; border-radius: 3px; background: #efe6d2; color: #1a1c1e; cursor: pointer; }
      #bar button[aria-pressed='true'] { background: #1a1c1e; color: #efe6d2; }
      #bar .chip { width: 14px; height: 14px; display: inline-block; vertical-align: -3px; margin-right: 5px; border: 1px solid #000; }
    </style>
  </head>
  <body>
    <iframe id="bench" title="bench"></iframe>
    <div id="bar"></div>
    <script>
      import { SCHEME_IDS, SCHEMES, slotColour, type SchemeId } from '../workshop/view/materials/scheme.ts';

      const q = new URLSearchParams(location.search);
      const pass = new URLSearchParams(q);
      for (const k of ['scheme', 'cut', 'ox', 'oy', 'oz', 'bar']) pass.delete(k);
      if (q.get('bar') === '0') document.getElementById('bar')!.style.display = 'none';
      if (!pass.has('hud')) pass.set('hud', '0');
      const frame = document.getElementById('bench') as HTMLIFrameElement;
      frame.src = `/dev/bench/?${pass.toString()}`;
      const bar = document.getElementById('bar')!;
      const origin: [number, number, number] = [Number(q.get('ox') ?? -1.0), Number(q.get('oy') ?? 0.6), Number(q.get('oz') ?? 1.85)];
      const cut = q.get('cut') === '1';

      type WS = {
        materials: { paint: { set(id: SchemeId, o?: object): void; current: SchemeId } };
        world: { time: number; cord(id: string): { jack: string | null } | undefined; setting(id: string, f: string): unknown };
        simWorld: { dispatch(i: object): void };
        dispatch(i: object): void;
      };
      const win = (): (Window & { __bench?: { ws: WS; shot(s: string): void }; __ready?: boolean }) | null => frame.contentWindow as never;

      const toHex = (c: readonly number[]): string => '#' + c.map((x) => Math.round(255 * (x <= 0.0031308 ? x * 12.92 : 1.055 * Math.pow(x, 1 / 2.4) - 0.055)).toString(16).padStart(2, '0')).join('');
      const buttons: Record<string, HTMLButtonElement> = {};
      function button(key: string, label: string, run: () => void, chip?: string): void {
        const b = document.createElement('button');
        if (chip) {
          const s = document.createElement('span');
          s.className = 'chip';
          s.style.background = chip;
          b.append(s);
        }
        b.append(label);
        b.addEventListener('click', run);
        bar.append(b);
        buttons[key] = b;
      }

      /** Paint the workshop in a scheme of the table at once (any letter, the runners-up too), wiped from the buttons' origin. */
      function scheme(id: SchemeId): void {
        const ws = win()?.__bench?.ws;
        if (!ws) return;
        ws.materials.paint.set(id, cut ? {} : { time: ws.world.time, origin });
        for (const k of SCHEME_IDS) buttons[k]?.setAttribute('aria-pressed', String(k === id));
      }
      /** The dial, as a hand works it: its crate opened if it is shut, then its knob one detent on. */
      function dial(): void {
        const ws = win()?.__bench?.ws;
        if (!ws) return;
        if (ws.world.setting('crate-3', 'open') !== true) return void ws.dispatch({ type: 'press', id: 'crate-3-lid' });
        ws.dispatch({ type: 'press', id: 'paint-dial-knob' });
      }
      /** The lamp as a visitor changes it: the cord into LAMP, then a text. */
      function lamp(text: string): void {
        const ws = win()?.__bench?.ws;
        if (!ws) return;
        if (ws.world.cord('cord')?.jack === 'jack-lamp') return void ws.simWorld.dispatch({ type: 'text', text });
        ws.simWorld.dispatch({ type: 'unplug', cord: 'cord' });
        setTimeout(() => {
          ws.simWorld.dispatch({ type: 'plug', cord: 'cord', jack: 'jack-lamp' });
          setTimeout(() => ws.simWorld.dispatch({ type: 'text', text }), 100);
        }, 100);
      }
      const shot = (s: string): void => win()?.__bench?.shot(s);

      for (const id of SCHEME_IDS) button(id, id, () => scheme(id), toHex(slotColour(id, 'teal-panel')));
      button('dial', 'dial', dial);
      button('warm', 'lamp warm', () => lamp('back to warm'));
      button('on', 'lamp on', () => lamp('lights on'));
      button('off', 'lamp off', () => lamp('lights out'));
      button('blue', 'lamp blue', () => lamp('make it blue'));
      for (const s of ['home', 'button', 'cord', 'line']) button(`shot-${s}`, s, () => shot(s));

      addEventListener('keydown', (e) => {
        const i = '123456'.indexOf(e.key);
        if (i >= 0 && SCHEME_IDS[i]) scheme(SCHEME_IDS[i]!);
        if (e.key === '0') scheme('A');
        if (e.key === 'd') dial();
        if (e.key === 'w') lamp('back to warm');
        if (e.key === 'o') lamp('lights on');
        if (e.key === 'n') lamp('lights out');
        if (e.key === 'b') lamp('make it blue');
        if (e.key === 'h') shot('home');
        if (e.key === 'u') shot('button');
        if (e.key === 'c') shot('cord');
        if (e.key === 'l') shot('line');
      });

      // when the bench is up: the asked-for scheme
      const wait = setInterval(() => {
        const w = win();
        if (!w?.__ready || !w.__bench) return;
        clearInterval(wait);
        const ws = w.__bench.ws;
        const start = q.get('scheme');
        if (start && start in SCHEMES) {
          ws.materials.paint.set(start as SchemeId);
          for (const k of SCHEME_IDS) buttons[k]?.setAttribute('aria-pressed', String(k === start));
        } else buttons['A']?.setAttribute('aria-pressed', 'true');
        (window as unknown as { __schemes: unknown }).__schemes = { scheme, dial, lamp, shot, ws };
        // for captures driving this page: the bench's hooks, and ready
        (window as unknown as { __bench: unknown }).__bench = w.__bench;
        (window as unknown as { __ready: boolean }).__ready = true;
      }, 200);
    </script>
  </body>
</html>
