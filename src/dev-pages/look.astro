---
// The early look (REWRITE.md § G P1 "The early look"; § B3): three objects
// under the lamp, as stills. The Button at the centre, a crate dropped askew
// to its left and a little forward (Fetch has just fumbled it), Fetch to the
// right in its `offer` pose turned toward the visitor; a run of lane tape;
// the real bench and back wall. Pieces come from the kit registry by name,
// built through their labels hook so tape, plates and stencils carry text;
// until one is registered a clay stand-in of its size holds its place (the
// read-out says so). Dev-only; never shipped.
//
// Query:
//   ?shot=three|button|crate|fetch|fetches   the group (default), a portrait of one, or both Fetch designs side by side
//   ?fetch=<name>                    which Fetch design (default: 'fetch', else the first 'fetch-…')
//   ?crate=<variant>                 the crate's variant (default M)
//   ?pose=<name>                     Fetch's pose (default offer, when it has one)
//   ?lamp=0..1  ?tier=high|low  ?post=0|1  ?hud=0  ?manual=1  ?seed=<n>
//
// Capture (from the repo root):
//   node scripts/capture.ts "/dev/look/?hud=0" --out shots/<pkg>/look-three.png
//   node scripts/capture.ts "/dev/look/?shot=button&hud=0" --out shots/<pkg>/look-button.png
//   node scripts/capture.ts "/dev/look/?hud=0" --mobile --out shots/<pkg>/look-three-phone.png
//   node scripts/capture.ts "/dev/look/?hud=0" --w 320 --h 200 --out shots/<pkg>/look-320.png
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Early look</title>
    <style is:global>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #12292c; }
      canvas { display: block; width: 100vw; height: 100vh; }
      #hud { position: fixed; left: 8px; bottom: 6px; font: 11px/1.35 ui-monospace, monospace; color: #bfe3d8; opacity: 0.75; white-space: pre; pointer-events: none; text-shadow: 0 0 3px #000; }
    </style>
  </head>
  <body>
    <canvas id="c"></canvas>
    <div id="hud"></div>
    <script>
      import { Box3, Vector3, type Object3D } from 'three';
      import { mountShowcase, type Placement } from '../workshop/view/catalogue/mount.ts';
      import { firstPiece, listPieces, buildEntry, type Entry } from '../workshop/view/catalogue/registry.ts';
      import { TABLEAU, FETCHES, LOOK_LAMP, TAPE_RUN, SHOTS, standInPiece, shotCamera, type Role, type Shot } from '../workshop/view/catalogue/tableau.ts';
      import { laneTape } from '../workshop/view/kit/pieces/bench/index.ts';

      const q = new URLSearchParams(location.search);
      const canvas = document.getElementById('c') as HTMLCanvasElement;
      const hud = document.getElementById('hud')!;
      const shot = ((SHOTS as readonly string[]).includes(q.get('shot') ?? '') ? q.get('shot') : 'three') as Shot;
      const seed = q.get('seed') === null ? 1 : Number(q.get('seed'));
      const lampQ = q.get('lamp');

      async function main(): Promise<void> {
        const fetchName = q.get('fetch');
        const wanted: Record<Role, string[]> = {
          button: ['button'],
          crate: ['crate'],
          fetch: fetchName ? [fetchName] : ['fetch', 'fetch-*'],
        };
        const show = await mountShowcase(canvas, {
          tier: q.get('tier') === 'low' ? 'low' : 'high',
          post: q.get('post') !== '0',
          lamp: lampQ === null ? null : Math.min(1, Math.max(0, Number(lampQ))),
          manual: q.get('manual') === '1',
          wall: true,
        });
        show.stage.lights.setBulb(LOOK_LAMP.bulb, LOOK_LAMP.aim);
        show.stage.lights.key.angle = (LOOK_LAMP.angleDeg * Math.PI) / 180;
        show.add(laneTape({ points: TAPE_RUN, seed: 4 }), { blob: 0 });

        const status: string[] = [];
        const boxes: Partial<Record<Role | 'fetchA' | 'fetchB', Box3>> = {};
        /** Build an entry for a role with its labels and pose, or a clay stand-in; place it. */
        const place = (role: Role, entry: Entry | undefined, at: Placement & { seed: number }): Object3D => {
          if (!entry) {
            status.push(`${role}: STAND-IN (no '${wanted[role].join("' or '")}' registered yet)`);
            return show.add(standInPiece(role), { ...at, view: 'clay' });
          }
          const opts: Record<string, unknown> = { seed: seed + at.seed };
          let variant: string | null = null;
          if (role === 'crate') variant = q.get('crate') ?? (entry.variants?.['M'] ? 'M' : null);
          if (role === 'fetch') {
            const pose = q.get('pose') ?? 'offer';
            if (entry.poses?.includes(pose)) opts['pose'] = pose;
            else if (entry.variants?.[pose]) variant = pose; // a design that lists its expressions as variants
          }
          const piece = buildEntry(entry, variant, opts, show.labels);
          status.push(`${role}: ${entry.name}${variant ? ` [${variant}]` : ''}${opts['pose'] ? ` pose ${String(opts['pose'])}` : ''}${entry.labels ? ' +labels' : ''}  ${piece.triangles} tris`);
          return show.add(piece, at);
        };

        if (shot === 'fetches') {
          const { entries } = await listPieces();
          const designs = entries.filter((e) => e.name === 'fetch' || e.name.startsWith('fetch-')).slice(0, 2);
          FETCHES.forEach((at, i) => {
            const o = place('fetch', designs[i], at);
            boxes[i === 0 ? 'fetchA' : 'fetchB'] = show.boxOf(o);
          });
        } else {
          for (const role of ['button', 'crate', 'fetch'] as const) {
            boxes[role] = show.boxOf(place(role, await firstPiece(wanted[role]), TABLEAU[role]));
          }
        }

        const aspect = canvas.clientWidth / Math.max(1, canvas.clientHeight);
        const cam = shotCamera(shot, boxes, aspect);
        show.look(new Box3().setFromCenterAndSize(cam.focus, new Vector3(1, 1, 1)), cam.distance, { focus: cam.focus });
        (window as unknown as { __look: unknown }).__look = { show, boxes, cam, status };

        if (q.get('hud') !== '0') {
          let n = 0;
          const tick = (): void => {
            if (++n % 15 === 0) {
              const st = show.stage.stats();
              const ft = show.hooks.stats().frameTimes;
              hud.textContent = `early look · ${shot}  ground: ${show.groundSource}  wall: ${show.wallSource}\n${status.join('\n')}\ndraw calls ${st.scene.calls}  tris ${st.scene.triangles}  frame ${ft.median.toFixed(1)} ms`;
            }
            requestAnimationFrame(tick);
          };
          tick();
        }
        show.start();
      }

      main().catch((e: unknown) => {
        console.error(e);
        hud.textContent = String(e);
      });
    </script>
  </body>
</html>
